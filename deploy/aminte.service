# Reference copy. Compare it with the installed unit before you replace it (deploy/README.md).
[Unit]
Description=Aminte server (life.db)
After=network.target

[Service]
Type=simple
# Replace OWNER and the paths.
User=OWNER
ExecStart=/home/OWNER/.local/bin/aminte --db /home/OWNER/aminte/life.db serve --token-file /home/OWNER/life/token --snapshots /home/OWNER/snapshots --with web
# the core listens on 127.0.0.1:7777 only. The token file turns on its bearer check: one line of 32 characters or more,
# with no space or tab at its start or end
# --with web runs the browser (extensions/web) beside the server: aminte-web must be beside aminte
# the browser listens on AMINTE_WEB_LISTEN. The local proxy points to it, and not to the core
# AMINTE_WEB_ORIGINS is the origin that the proxy shows to the browser
Environment=AMINTE_WEB_LISTEN=127.0.0.1:7780
Environment=AMINTE_WEB_ORIGINS=https://aminte.example
# with ProtectHome=read-only, the browser's state folder must be writable: ReadWritePaths=/home/OWNER/.config/aminte-web
# add --with NAME to run a connected app beside the server; with ProtectHome=read-only, its state folder must be
# writable: ReadWritePaths=/home/OWNER/.config/aminte-NAME
Restart=on-failure
# systemd stops the server with SIGTERM. aminte then drains the requests that it admitted (up to 10 seconds) and
# closes life.db. TimeoutStopSec is longer than the drain, so systemd sends SIGKILL only to a server that is stuck.
KillSignal=SIGTERM
# mixed: SIGTERM reaches aminte alone, which interrupts its --with children first and then drains; the group is killed only on the timeout
KillMode=mixed
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
