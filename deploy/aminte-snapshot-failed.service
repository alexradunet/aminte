# Reference copy. Compare it with the installed unit before you replace it (deploy/README.md).
# Started by OnFailure= of aminte-snapshot.service. It only writes one line to the journal, at priority "error"
# (the "<3>" prefix). Read it with: journalctl -p err -t aminte-snapshot-failed
[Unit]
Description=Aminte nightly snapshot failed

[Service]
Type=oneshot
SyslogIdentifier=aminte-snapshot-failed
ExecStart=/bin/echo "<3>the nightly snapshot of life.db failed; read: journalctl -u aminte-snapshot.service"
